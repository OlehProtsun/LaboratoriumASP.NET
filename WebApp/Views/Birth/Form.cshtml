@model dynamic

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<div class="container">
    <div class="row justify-content-md-center">
        <div class="col-6">
            <h2>Birth</h2>
            <form action="Result" method="POST">
                <div class="mb-3">
                    <label class="form-label" for="BirthDate">Data urodzenia</label>
                    <input class="form-control" type="date" name="BirthDate" step="0.00001" id="BirthDate"/>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="Name">Imię</label>
                    <input class="form-control" type="text" name="Name" step="0.00001" id="name"/>
                </div>
                <div class="mb-3">
                    <button class="btn btn-primary" type="submit">Oblicz</button>
                </div>
            </form>
        </div>
    </div>
</div>
