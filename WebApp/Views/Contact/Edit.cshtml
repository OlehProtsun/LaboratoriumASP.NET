@model ContactModel

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>Edytuj kontakt</h2>
<form asp-action="Edit" method="post">
    <input asp-for="Id"/>
    
    <div class="mb-3">
        <lable class="form-label" asp-for="FirstName">FirstName</lable>
        <input class="form-control" asp-for="FirstName"/>
        <span class="text-danger" asp-validation-for="FirstName"></span>
    </div>

    <div class="mb-3">
        <lable class="form-label" asp-for="LastName">LastName</lable>
        <input class="form-control" asp-for="LastName"/>
        <span class="text-danger" asp-validation-for="LastName"></span>
    </div>

    <div class="mb-3">
        <lable class="form-label" asp-for="Email">Email</lable>
        <input class="form-control" asp-for="Email"/>
        <span class="text-danger" asp-validation-for="Email"></span>
    </div>

    <div class="mb-3">
        <lable class="form-label" asp-for="PhoneNumber">PhoneNumber</lable>
        <input class="form-control" asp-for="PhoneNumber"/>
        <span class="text-danger" asp-validation-for="PhoneNumber"></span>
    </div>

    <div class="mb-3">
        <lable class="form-label" asp-for="BirthDate">BirthDate</lable>
        <input class="form-control" asp-for="BirthDate"/>
        <span class="text-danger" asp-validation-for="BirthDate"></span>
    </div>

    <div class="mb-3">
        <lable class="form-label" asp-for="Category">Category</lable>
        <select
            class="form-control"
            asp-for="Category"
            asp-items="@Html.GetEnumSelectList<Category>()">
        </select>
        <span class="text-danger" asp-validation-for="Category"></span>
    </div>

    <button type="submit" class="btn btn-outline-primary">Zapisz</button>
    <button type="reset" class="btn btn-outline-danger">Reset</button>
</form>